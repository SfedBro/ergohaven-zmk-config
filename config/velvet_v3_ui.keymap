#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L_GAME    0
#define L_WORKMAN 1
#define L_RU      2
#define L_NAV     3
#define L_SYM     4

/ {
    macros {
        go_game: go_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_GAME &kp F13>;
        };

        go_workman: go_workman {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_WORKMAN &kp LA(LSHFT) &kp F14>;
        };

        go_ru: go_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_RU &kp LA(LSHFT) &kp F15>;
        };
    };

    behaviors {
        nav_spc: nav_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_SPC";
            bindings = <&mo L_NAV>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        sym_bspc: sym_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "SYM_BSPC";
            bindings = <&mo L_SYM>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        lpar_rpar: lpar_rpar {
            compatible = "zmk,behavior-mod-morph";
            label = "LPAR_RPAR";
            bindings = <&kp LPAR>, <&kp RPAR>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbrc_rbrc: lbrc_rbrc {
            compatible = "zmk,behavior-mod-morph";
            label = "LBRC_RBRC";
            bindings = <&kp LBRC>, <&kp RBRC>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbkt_rbkt: lbkt_rbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "LBKT_RBKT";
            bindings = <&kp LBKT>, <&kp RBKT>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_gt: lt_gt {
            compatible = "zmk,behavior-mod-morph";
            label = "LT_GT";
            bindings = <&kp LT>, <&kp GT>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        and_or: and_or {
            compatible = "zmk,behavior-mod-morph";
            label = "AND_OR";
            bindings = <&kp AMPS>, <&kp PIPE>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_plus: minus_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_PLUS";
            bindings = <&kp MINUS>, <&kp PLUS>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        quotes: quotes {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTES";
            bindings = <&kp SQT>, <&kp DOUBLE_QUOTES>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        game_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T                      &kp Y  &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G                      &kp H  &kp J  &kp K     &kp L   &kp SQT  &kp ENTER
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp B  &kp N     &kp M   &none    &kp RSHFT
                  &kp QUESTION &kp EXCL                          &kp DOT &kp COMMA
                  &kp LALT &kp SPACE &mo L_NAV                   &none &none &none
            >;
        };

        workman_layer {
            bindings = <
&kp ESC    &kp Q  &kp D  &kp R  &kp W  &none                      &none  &kp F  &kp U     &kp P   &kp J    &kp TAB
&kp LSHFT  &kp A  &kp S  &kp H  &kp T  &kp G                      &kp Y  &kp N  &kp E     &kp O   &kp I    &none
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp M  &kp L     &kp B   &kp K    &kp RSHFT
                  &kp QUESTION &kp EXCL                          &kp DOT &kp COMMA
                  &kp ENTER &nav_spc L_NAV SPACE &sym_bspc L_SYM BSPC  &none &none &none
            >;
        };

        russian_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T                      &kp Y  &kp U  &kp I     &kp O   &kp P    &kp TAB
&kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G                      &kp H  &kp J  &kp K     &kp L   &kp SEMI &none
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp B  &kp N     &kp M   &none    &kp RSHFT
                  &kp QUESTION &kp EXCL                          &kp DOT &kp COMMA
                  &kp ENTER &nav_spc L_NAV SPACE &sym_bspc L_SYM BSPC  &none &none &none
            >;
        };

        nav_layer {
            bindings = <
&bt BT_CLR &go_game     &go_workman  &go_ru       &trans &none    &kp F16  &kp PG_UP &kp UP   &kp PG_DN &trans   &sys_reset
&trans     &mkp LCLK    &mkp RCLK    &mkp MCLK    &trans &none    &none    &kp LEFT  &kp DOWN &kp RIGHT &trans   &trans
&trans     &kp HOME     &kp END      &trans       &trans &none    &none    &kp HOME  &trans   &kp END   &trans   &trans
                        &kp C_VOL_DN &kp C_VOL_UP                         &trans    &trans
                        &trans &trans &trans                              &none &none &none
            >;
        };

        sym_layer {
            bindings = <
&trans     &kp N1     &kp N2     &kp N3     &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0      &trans
&trans     &lbrc_rbrc &lpar_rpar &lbkt_rbkt &lt_gt   &kp GRAVE    &kp EQUAL &minus_plus &quotes &kp SEMI  &kp COLON   &trans
&trans     &and_or    &kp BSLH   &kp EXCL   &kp HASH  &kp TILDE    &kp F17   &kp PIPE  &kp AMPS  &kp TILDE &kp EXCL    &trans
                      &trans     &trans                                      &trans    &trans
                      &trans     &trans     &trans                           &trans    &trans    &trans
            >;
        };
    };
};
