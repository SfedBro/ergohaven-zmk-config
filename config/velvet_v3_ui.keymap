#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L_GAME    0
#define L_WORKMAN 1
#define L_RU      2
#define L_NAV     3
#define L_SYM     4

/ {
    macros {
        go_game: go_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_GAME>, <&kp F13>;
        };

        go_workman: go_workman {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_WORKMAN>, <&kp LA(LSFT)>, <&kp F14>;
        };

        go_ru: go_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_RU>, <&kp LA(LSFT)>, <&kp F15>;
        };

        // Хоткей Скриншота Windows (Win + Shift + S)
        screen_snippet: screen_snippet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
        };

        // Хоткей Диспетчера Задач (Ctrl + Shift + Esc)
        task_mgr: task_mgr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(ESC))>;
        };
    };

    behaviors {
        nav_spc: nav_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_SPC";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        sym_bspc: sym_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "SYM_BSPC";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        lpar_rpar: lpar_rpar {
            compatible = "zmk,behavior-mod-morph";
            label = "LPAR_RPAR";
            bindings = <&kp LPAR>, <&kp RPAR>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbrc_rbrc: lbrc_rbrc {
            compatible = "zmk,behavior-mod-morph";
            label = "LBRC_RBRC";
            bindings = <&kp LBRC>, <&kp RBRC>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbkt_rbkt: lbkt_rbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "LBKT_RBKT";
            bindings = <&kp LBKT>, <&kp RBKT>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_gt: lt_gt {
            compatible = "zmk,behavior-mod-morph";
            label = "LT_GT";
            bindings = <&kp LT>, <&kp GT>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        and_or: and_or {
            compatible = "zmk,behavior-mod-morph";
            label = "AND_OR";
            bindings = <&kp AMPS>, <&kp PIPE>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_plus: minus_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_PLUS";
            bindings = <&kp MINUS>, <&kp PLUS>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        quotes: quotes {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTES";
            bindings = <&kp SQT>, <&kp DOUBLE_QUOTES>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* LAYER 0: GAME */
        game_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T                      &kp Y  &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G                      &kp H  &kp J  &kp K     &kp L   &kp SQT  &kp ENTER
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp B  &kp N     &kp M   &none    &kp RSHFT
                  &kp QUESTION &kp EXCL                          &kp LALT &kp SPACE &mo L_NAV
                  &kp DOT &kp COMMA &none                        &none &none &none
            >;
        };

        /* LAYER 1: WORKMAN */
        workman_layer {
            bindings = <
&kp ESC    &kp Q  &kp D  &kp R  &kp W  &none                      &none  &kp F  &kp U     &kp P   &kp J    &kp TAB
&kp LSHFT  &kp A  &kp S  &kp H  &kp T  &kp G                      &kp Y  &kp N  &kp E     &kp O   &kp I    &none
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp M  &kp L     &kp B   &kp K    &kp RSHFT
                  &kp QUESTION &kp EXCL                          &kp ENTER &nav_spc L_NAV SPACE &sym_bspc L_SYM BSPC
                  &kp DOT &kp COMMA &none                        &none &none &none
            >;
        };

        /* LAYER 2: RUSSIAN (Полный набор 33 букв!) */
        russian_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T                      &kp Y  &kp U  &kp I     &kp O   &kp P    &kp LBKT
&kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G                      &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp GRAVE                  &kp RBKT &kp B  &kp N   &kp M   &kp COMMA &kp DOT
                  &kp QUESTION &kp EXCL                          &kp ENTER &nav_spc L_NAV SPACE &sym_bspc L_SYM BSPC
                  &none &none &none                              &none &none &none
            >;
        };

        /* LAYER 3: NAV (Навигация + Скриншот + Task Manager + Win+D + Alt+Tab + F1-F12!) */
        nav_layer {
            bindings = <
&bt BT_CLR &go_game     &go_workman  &go_ru       &screen_snippet &task_mgr   &kp F16  &kp F1  &kp F2   &kp F3   &kp F4   &kp F11
&trans     &mkp LCLK    &mkp RCLK    &mkp MCLK    &kp LA(TAB)     &kp LG(D)   &none    &kp LEFT &kp DOWN &kp RIGHT &kp F5   &kp F12
&trans     &kp HOME     &kp END      &trans       &trans          &none       &none    &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
                        &kp C_VOL_DN &kp C_VOL_UP                             &trans   &trans
                        &trans &trans &trans                                  &none &none &none
            >;
        };

        /* LAYER 4: SYM (Символы C#/C++ + Цифры 1-0) */
        sym_layer {
            bindings = <
&trans     &kp N1     &kp N2     &kp N3     &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0      &trans
&trans     &lbrc_rbrc &lpar_rpar &lbkt_rbkt &lt_gt   &kp GRAVE    &kp EQUAL &minus_plus &quotes &kp SEMI  &kp COLON   &trans
&trans     &and_or    &kp BSLH   &kp EXCL   &kp HASH  &kp TILDE    &kp F17   &kp PIPE  &kp AMPS  &kp TILDE &kp EXCL    &trans
                      &trans     &trans                                      &trans    &trans
                      &trans     &trans     &trans                           &trans    &trans    &trans
            >;
        };
    };
};
