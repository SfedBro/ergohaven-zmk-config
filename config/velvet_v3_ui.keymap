#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L_GAME    0
#define L_WORKMAN 1
#define L_RU      2
#define L_NAV     3
#define L_SYM     4

/ {
    macros {
        go_game: go_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_GAME &kp F13>;
        };

        go_workman: go_workman {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_WORKMAN &kp F14>;
        };

        go_ru: go_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_RU &kp F15>;
        };
    };

    behaviors {
        // Левый большой палец: Нажатие = Space, Зажатие = NAV слой
        nav_spc: nav_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_SPC";
            bindings = <&mo L_NAV>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        // Второй большой палец: Нажатие = Backspace, Зажатие = SYM слой
        sym_bspc: sym_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "SYM_BSPC";
            bindings = <&mo L_SYM>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        minus_plus: minus_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_PLUS";
            bindings = <&kp MINUS>, <&kp PLUS>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        quotes: quotes {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTES";
            bindings = <&kp SQT>, <&kp DOUBLE_QUOTES>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* -------------------------------------------------------------------------------------------------
         * LAYER 0: GAME (Чистый Space, без вылетов слоев)
         * ------------------------------------------------------------------------------------------------- */
        game_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T                      &kp Y  &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp CAPS   &kp A  &kp S  &kp D  &kp F  &kp G                      &kp H  &kp J  &kp K     &kp L   &kp SQT  &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp B  &kp N     &kp M   &kp RSHFT &go_workman
                  &kp QUESTION &kp EXCL                          &kp DOT &kp COMMA
                  &kp LCTRL &kp SPACE &mo L_NAV                  &none &kp ENTER &none
            >;
        };

        /* -------------------------------------------------------------------------------------------------
         * LAYER 1: WORKMAN (Твоя раскладка, Enter и Backspace на больших пальцах!)
         * ------------------------------------------------------------------------------------------------- */
        workman_layer {
            bindings = <
&kp ESC    &kp Q  &kp D  &kp R  &kp W  &none                      &none  &kp F  &kp U     &kp P   &kp J    &kp TAB
&kp CAPS   &kp A  &kp S  &kp H  &kp T  &kp G                      &kp Y  &kp N  &kp E     &kp O   &kp I    &none
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp M  &kp L     &kp B   &lt L_NAV K &kp RSHFT
                  &kp QUESTION &kp EXCL                          &kp DOT &kp COMMA
                  &kp ENTER &nav_spc L_NAV SPACE &sym_bspc L_SYM BSPC  &none &go_ru &none
            >;
        };

        /* -------------------------------------------------------------------------------------------------
         * LAYER 2: RUSSIAN (Русский ЙЦУКЕН)
         * ------------------------------------------------------------------------------------------------- */
        russian_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T                      &kp Y  &kp U  &kp I     &kp O   &kp P    &kp TAB
&kp CAPS   &kp A  &kp S  &kp D  &kp F  &kp G                      &kp H  &kp J  &kp K     &kp L   &kp SEMI &none
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &none                      &none  &kp B  &kp N     &kp M   &none    &go_workman
                  &kp QUESTION &kp EXCL                          &kp DOT &kp COMMA
                  &kp ENTER &nav_spc L_NAV SPACE &sym_bspc L_SYM BSPC  &none &go_workman &none
            >;
        };

        /* -------------------------------------------------------------------------------------------------
         * LAYER 3: NAV & MOUSE (Левая рука — КЛИКИ МЫШИ, Правая рука — ТРЕКБОЛ + СТРЕЛКИ)
         * ------------------------------------------------------------------------------------------------- */
        nav_layer {
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &none    &kp F16  &kp PG_UP &kp UP   &kp PG_DN &trans   &sys_reset
&trans     &mkp LCLK    &mkp RCLK    &mkp MCLK    &trans &none    &none    &kp LEFT  &kp DOWN &kp RIGHT &trans   &trans
&trans     &kp HOME     &kp END      &trans       &trans &none    &none    &kp HOME  &trans   &kp END   &trans   &trans
                        &kp C_VOL_DN &kp C_VOL_UP                         &trans    &trans
                        &trans &trans &trans                              &none &none &none
            >;
        };

        /* -------------------------------------------------------------------------------------------------
         * LAYER 4: SYM & NUM (Цифры вверху 1-0, Программирование C#/C++ под пальцами)
         * ------------------------------------------------------------------------------------------------- */
        sym_layer {
            bindings = <
&trans     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5          &kp N6    &kp N7    &kp N8    &kp N9    &kp N0      &trans
&trans     &kp LBRC  &kp RBRC  &kp LPAR  &kp RPAR  &kp GRAVE       &kp EQUAL &minus_plus &quotes &kp SEMI  &kp COLON   &trans
&trans     &kp LBKT  &kp RBKT  &kp LT    &kp GT    &kp TILDE       &kp F17   &kp BSLH  &kp PIPE &kp AMPS  &kp EXCL    &trans
                     &trans    &trans                                        &trans    &trans
                     &trans    &trans    &trans                              &trans    &trans    &trans
            >;
        };
    };
};
