#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define L_GAME    0
#define L_WORKMAN 1
#define L_RU      2
#define L_NAV     3
#define L_SYM     4

/ {
    macros {
        go_game: go_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_GAME>, <&kp F13>;
        };

        go_workman: go_workman {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_WORKMAN>, <&kp F14>;
        };

        go_ru: go_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_RU>, <&kp F15>;
        };

        screen_snippet: screen_snippet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
        };

        task_mgr: task_mgr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(ESC))>;
        };

        mo_f16: mo_f16 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press &mo MACRO_PLACEHOLDER>,
                <&macro_press &kp F16>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release &mo MACRO_PLACEHOLDER>,
                <&macro_release &kp F16>;
        };

        mo_f17: mo_f17 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press &mo MACRO_PLACEHOLDER>,
                <&macro_press &kp F17>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release &mo MACRO_PLACEHOLDER>,
                <&macro_release &kp F17>;
        };
    };

    behaviors {
        nav_spc: nav_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_SPC";
            bindings = <&mo_f16>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            flavor = "balanced";
        };

        sym_bspc: sym_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "SYM_BSPC";
            bindings = <&mo_f17>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            flavor = "balanced";
        };

        comma_dot: comma_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_DOT";
            bindings = <&kp COMMA>, <&kp DOT>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        excl_quest: excl_quest {
            compatible = "zmk,behavior-mod-morph";
            label = "EXCL_QUEST";
            bindings = <&kp EXCL>, <&kp QUESTION>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lpar_rpar: lpar_rpar {
            compatible = "zmk,behavior-mod-morph";
            label = "LPAR_RPAR";
            bindings = <&kp LPAR>, <&kp RPAR>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbrc_rbrc: lbrc_rbrc {
            compatible = "zmk,behavior-mod-morph";
            label = "LBRC_RBRC";
            bindings = <&kp LBRC>, <&kp RBRC>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lbkt_rbkt: lbkt_rbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "LBKT_RBKT";
            bindings = <&kp LBKT>, <&kp RBKT>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_gt: lt_gt {
            compatible = "zmk,behavior-mod-morph";
            label = "LT_GT";
            bindings = <&kp LT>, <&kp GT>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        eq_under: eq_under {
            compatible = "zmk,behavior-mod-morph";
            label = "EQ_UNDER";
            bindings = <&kp EQUAL>, <&kp UNDER>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_plus: minus_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_PLUS";
            bindings = <&kp MINUS>, <&kp PLUS>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        div_mul: div_mul {
            compatible = "zmk,behavior-mod-morph";
            label = "DIV_MUL";
            bindings = <&kp SLASH>, <&kp ASTERISK>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        and_or: and_or {
            compatible = "zmk,behavior-mod-morph";
            label = "AND_OR";
            bindings = <&kp AMPS>, <&kp PIPE>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        quotes: quotes {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTES";
            bindings = <&kp SQT>, <&kp DOUBLE_QUOTES>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        at_hash: at_hash {
            compatible = "zmk,behavior-mod-morph";
            label = "AT_HASH";
            bindings = <&kp AT>, <&kp HASH>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        percent_caret: percent_caret {
            compatible = "zmk,behavior-mod-morph";
            label = "PERCENT_CARET";
            bindings = <&kp PRCNT>, <&kp CARET>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        grave_tilde: grave_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "GRAVE_TILDE";
            bindings = <&kp GRAVE>, <&kp TILDE>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* LAYER 0: GAME */
        game_layer {
            bindings = <
&kp ESC    &kp Q  &kp W         &kp E     &kp R     &kp T                            &kp Y      &kp U  &kp I        &kp O         &kp P        &kp BSPC
&kp LSHFT  &kp A  &kp S         &kp D     &kp F     &kp G                            &kp H      &kp J  &kp K        &kp L         &kp SQT      &kp ENTER
&kp LCTRL  &kp Z  &kp X         &kp C     &kp V     &kp B                            &kp N      &kp M  &kp COMMA    &kp DOT       &kp AT       &kp RSHFT
                  &kp LGUI      &excl_quest &kp LALT &kp SPACE &mo_f16 L_NAV  &none &none &none &comma_dot &none
            >;
        };

        /* LAYER 1: WORKMAN */
        workman_layer {
            bindings = <
&kp ESC    &kp Q  &kp D         &kp R     &kp W      &none                                          &none      &kp F  &kp U  &kp P  &kp J  &kp TAB
&kp LSHFT  &kp A  &kp S         &kp H     &kp T      &kp G                                          &kp Y      &kp N  &kp E  &kp O  &kp I  &none
&kp LCTRL  &kp Z  &kp X         &kp C     &kp V      &none                                          &none      &kp M  &kp L  &kp B  &kp K  &kp RSHFT
                  &kp LGUI      &excl_quest &kp ENTER &sym_bspc 4 SPACE &nav_spc 3 BSPC  &none &none &none &comma_dot &none
            >;
        };

        /* LAYER 2: RUSSIAN (Ё на первом правом большом пальце &kp GRAVE) */
        russian_layer {
            bindings = <
&kp ESC    &kp Q  &kp W         &kp E     &kp R      &kp T                                        &kp Y     &kp U  &kp I       &kp O    &kp P     &kp LBKT
&kp LSHFT  &kp A  &kp S         &kp D     &kp F      &kp G                                        &kp H     &kp J  &kp K       &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X         &kp C     &kp V      &kp B                                        &kp N     &kp M  &kp COMMA   &kp DOT  &kp RBKT  &kp RSHFT
                  &kp LGUI      &excl_quest &kp ENTER &sym_bspc 4 SPACE &nav_spc 3 BSPC  &kp GRAVE &none &none &comma_dot &kp GRAVE
            >;
        };

        /* LAYER 3: NAV */
        nav_layer {
            bindings = <
&bt BT_CLR  &go_game      &go_workman   &go_ru        &screen_snippet  &task_mgr                    &none    &kp F1    &kp UP    &kp F3     &kp F4  &kp F11
&kp HOME    &kp LA(TAB)   &mkp MCLK     &mkp RCLK     &mkp LCLK        &kp LG(D)                    &none    &kp LEFT  &kp DOWN  &kp RIGHT  &kp F5  &kp F12
&kp END     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4                 &none    &kp F6    &kp F7    &kp F8     &kp F9  &kp F10
                          &kp C_VOL_DN  &kp C_VOL_UP  &trans           &trans     &trans    &trans  &trans   &none     &none     &none
            >;
        };

        /* LAYER 4: SYM */
        sym_layer {
            bindings = <
&trans  &kp N1      &kp N2      &kp N3          &kp N4          &kp N5                          &kp N6     &kp N7       &kp N8     &kp N9        &kp N0     &trans
&trans  &lbkt_rbkt  &lt_gt      &lbrc_rbrc      &lpar_rpar      &grave_tilde                    &none      &eq_under    &minus_plus &quotes     &kp SEMI   &none
&trans  &kp DLLR    &at_hash    &percent_caret  &and_or         &kp BSLH                        &none      &excl_quest  &div_mul   &comma_dot    &quotes    &trans
                    &trans      &trans          &trans          &trans        &trans    &trans  &trans     &trans       &trans     &trans
            >;
        };
    };
};
